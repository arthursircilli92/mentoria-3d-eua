{
  "buildCommand": "node scripts/build.js",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/pack-prompts/api/(.*)", "destination": "/api/pack-prompts/$1" },
    { "source": "/pack-prompts/", "destination": "/api/pack-prompts/index" },
    { "source": "/pack-prompts", "destination": "/api/pack-prompts/index" }
  ],
  "functions": {
    "api/acesso.js": { "includeFiles": "private/calculadora.html" },
    "api/pack-prompts/index.js": { "includeFiles": "dist/pack-prompts/index.html" },
    "api/pack-prompts/acesso-pack.js": { "includeFiles": "pack-prompts/private/galeria.html" },
    "api/pack-prompts/create-checkout-pack.js": { "maxDuration": 10 }
  }
}